<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.a0000.quant-agents.dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/a0000/.local/share/quant-agents/app &amp;&amp; /Users/a0000/.local/share/quant-agents/venv/bin/python tools/serve_dashboard.py --host 127.0.0.1 --port 8788 --directory web_dashboard</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/a0000/.local/share/quant-agents/app</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/a0000/Library/Logs/quant_agents_dashboard.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/a0000/Library/Logs/quant_agents_dashboard.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
